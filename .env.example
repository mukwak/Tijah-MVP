# WhatsApp Business API (Meta Cloud API)
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=tijah_verify_2024
META_APP_SECRET=your_meta_app_secret
VERIFY_WEBHOOK_SIGNATURE=true

# Google Gemini (PRIMARY - cheapest for NLU parsing)
# Get free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (for Whisper speech-to-text only)
OPENAI_API_KEY=your_openai_api_key

# Server
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-domain.com

# Database
# Leave blank for local SQLite. Use a free Neon/Supabase Postgres URL for alpha.
DATABASE_URL=
DB_PATH=tijah.db

# Admin dashboard: open /admin/<token> in a browser. Leave blank to disable.
ADMIN_TOKEN=

# Voice reply (OpenAI TTS). gpt-4o-mini-tts supports accent instructions.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx
